DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ordexa?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Configure para habilitar verificação de e-mail e recuperação de senha.
RESEND_API_KEY=""
EMAIL_FROM="Ordexa <contato@seudominio.com>"

# Mercado Pago: checkout recorrente e webhook de assinaturas.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Protege o endpoint de reprocessamento da fila de e-mails (cron).
# Configure no provedor: GET /api/cron/email-outbox com Authorization: Bearer <segredo>.
CRON_SECRET=""

# Rate limit da loja pública: confie em X-Forwarded-For apenas atrás de um proxy
# que sobrescreve esse cabeçalho. Defina "false" se a aplicação estiver exposta
# diretamente (todos os clientes compartilharão o mesmo limite).
TRUST_PROXY="true"
